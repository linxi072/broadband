<!-- pages/account/bills.wxml -->
<view class="page">
  <view class="header">
    <text class="title">账单明细</text>
    <picker mode="selector" range="{{periods}}" value="{{periodIndex}}" bindchange="onPeriod">
      <view class="add">{{periods[periodIndex]}} ▾</view>
    </picker>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <view wx:elif="{{list.length === 0}}" class="empty">
    <view class="em-ic">🧾</view>
    <view class="em-t">该账期暂无账单</view>
    <view class="em-s">可在「账户中心」查看更多</view>
  </view>
  <view wx:else>
    <view class="item" wx:for="{{list}}" wx:key="id">
      <view class="item-top">
        <text class="pkg">{{item.packageName}}</text>
        <text class="amt">¥{{item.amount}}</text>
      </view>
      <view class="desc">{{item.typeLabel}}</view>
      <view class="meta">
        <text>{{item.dateText}}</text>
        <text class="pill">{{item.statusText}}</text>
      </view>
    </view>
  </view>
</view>
