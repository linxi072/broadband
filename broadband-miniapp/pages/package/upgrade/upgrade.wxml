<view class="page">
  <view class="topbar">套餐升级</view>
  <view class="body" wx:if="{{!loading}}">
    <view class="card tone">
      <view class="t">当前套餐：{{current.name}}</view>
      <view class="mini">¥{{current.fee}}/月 · 合约剩 {{current.contractLeftMonths}} 个月</view>
    </view>

    <view class="card">
      <view class="mini">带宽升级（单选）</view>
      <view class="chips">
        <view wx:for="{{options}}" wx:for-item="o" wx:key="key" wx:if="{{o.type==='bandwidth'}}"
              class="chip {{selectedBand===o.key ? 'on':''}}" data-key="{{o.key}}" bindtap="selectBand">
          {{o.name}}{{o.extraFee>0 ? ' +¥'+o.extraFee+'/月' : ''}}
        </view>
      </view>
    </view>

    <view class="card">
      <view class="mini">增值服务加购（多选）</view>
      <view class="chips">
        <view wx:for="{{options}}" wx:for-item="o" wx:key="key" wx:if="{{o.type==='addon'}}"
              class="chip {{selectedAddons.indexOf(o.key)>=0 ? 'on':''}}" data-key="{{o.key}}" bindtap="toggleAddon">
          {{o.name}} +¥{{o.extraFee}}
        </view>
      </view>
    </view>

    <view class="card">
      <view class="mini">生效方式</view>
      <view class="chips">
        <view class="chip {{effectType==='immediate'?'on':''}}" data-val="immediate" bindtap="selectEffect">立即生效</view>
        <view class="chip {{effectType==='nextMonth'?'on':''}}" data-val="nextMonth" bindtap="selectEffect">次月生效</view>
      </view>
    </view>

    <view class="card" wx:if="{{preview}}">
      <view class="mini">费用预览</view>
      <view class="line">月费：¥{{current.fee}} + 补差 ¥{{preview.monthDiff}} = <text class="bold">¥{{preview.fee}}/月</text></view>
      <view class="line">合约剩余折算一次性补差：¥{{preview.oneTime}}</view>
      <view class="line">生效：{{preview.effectType==='immediate'?'立即':'次月账单日'}}</view>
    </view>

    <view class="btn-primary" bindtap="submit">提交升级申请</view>
  </view>
</view>
