<!-- pages/support/support.wxml -->
<view class="page">
  <view class="seg">
    <view class="it {{catIdx === idx ? 'on' : ''}}" wx:for="{{cats}}" wx:key="*this" wx:for-index="idx" data-idx="{{idx}}" bindtap="onCat">{{item}}</view>
  </view>

  <view class="card-title">常见问题</view>
  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <view wx:elif="{{faqs.length === 0}}" class="empty">
    <view class="em-ic">💡</view><view class="em-t">该分类暂无问题</view>
  </view>
  <view wx:else>
    <view class="faq" wx:for="{{faqs}}" wx:key="id">
      <view class="faq-q" data-id="{{item.id}}" bindtap="toggle">
        <text>{{item.question}}</text>
        <text class="faq-toggle">{{expandedId === item.id ? '−' : '+'}}</text>
      </view>
      <view class="faq-a" wx:if="{{expandedId === item.id}}">{{item.answer}}</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">在线留言</view>
    <picker mode="selector" range="{{types}}" value="{{form.typeIdx}}" bindchange="onType">
      <view class="input picker">{{types[form.typeIdx]}}</view>
    </picker>
    <textarea class="input" placeholder="请描述您的问题（必填）" value="{{form.content}}" bindinput="onContent" maxlength="500"></textarea>
    <input class="input" placeholder="联系方式（手机/微信，选填）" value="{{form.contact}}" bindinput="onContact" />
    <view class="btn-primary" bindtap="submit">{{submitting ? '提交中...' : '提交咨询'}}</view>
  </view>
</view>
