/* pages/repair/repair.wxss */
.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding: 24rpx;
  box-sizing: border-box;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(37, 99, 235, 0.06);
}
.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 24rpx;
}
.field {
  margin-bottom: 28rpx;
}
.label {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}
.picker, .input, .textarea {
  width: 100%;
  box-sizing: border-box;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 22rpx 20rpx;
  font-size: 28rpx;
  color: #1e293b;
}
.textarea {
  height: 180rpx;
}
.submit {
  margin-top: 12rpx;
  background: #2563eb;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}
.tip {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #94a3b8;
  text-align: center;
}
