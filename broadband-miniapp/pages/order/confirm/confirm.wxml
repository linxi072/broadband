<view class="container">
  <view class="nav-bar">下单确认</view>
  <view class="card">
    <view class="card-title">套餐</view>
    <view class="row"><text class="muted">名称</text><text>{{pkg.name}}</text></view>
    <view class="row"><text class="muted">月费</text><text style="color:var(--c);font-weight:700">¥{{pkg.price}}/月</text></view>
    <view class="row"><text class="muted">合约期</text><text>{{period}} 个月</text></view>
  </view>
  <view class="card">
    <view class="card-title">安装信息</view>
    <view class="row"><text class="muted">地址</text><text>{{address}}</text></view>
    <view class="row"><text class="muted">联系人</text><text>{{contact}}</text></view>
  </view>
  <view class="btn-primary" bindtap="submit">提交订单</view>
</view>
