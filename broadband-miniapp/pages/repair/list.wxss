/* pages/repair/list.wxss */
.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding: 24rpx;
  box-sizing: border-box;
}
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1e293b;
}
.add {
  font-size: 26rpx;
  color: #2563eb;
}
.empty {
  margin-top: 120rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.link {
  color: #2563eb;
}
.item {
  background: #fff;
  border-radius: 18rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 4rpx 18rpx rgba(37, 99, 235, 0.05);
}
.item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.cat {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
}
.status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.status-PENDING { background: #fef3c7; color: #b45309; }
.status-ASSIGNED { background: #dbeafe; color: #1d4ed8; }
.status-INSTALLING { background: #ede9fe; color: #6d28d9; }
.status-DONE { background: #dcfce7; color: #15803d; }
.status-CANCELLED { background: #f1f5f9; color: #64748b; }
.desc {
  font-size: 26rpx;
  color: #475569;
  margin-bottom: 12rpx;
  line-height: 1.5;
}
.meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 16rpx;
}
.progress {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.bar {
  flex: 1;
  height: 10rpx;
  background: #e2e8f0;
  border-radius: 6rpx;
  overflow: hidden;
}
.fill {
  height: 100%;
  background: #2563eb;
  border-radius: 6rpx;
}
.pct {
  font-size: 22rpx;
  color: #94a3b8;
}
