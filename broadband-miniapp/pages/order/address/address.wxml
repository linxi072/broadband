<!-- pages/order/address/address.wxml -->
<view class="container">

  <!-- 小区校验 -->
  <view class="card">
    <view class="card-title">安装小区</view>
    <view class="search-bar">
      <input class="search-input" placeholder="输入小区名自动校验可装性" value="{{communityInput}}"
             bindinput="onInput" confirm-type="search" bindconfirm="doCheck" />
      <view class="search-btn" bindtap="doCheck">校验</view>
    </view>

    <block wx:if="{{searched && check}}">
      <!-- 可装 / 紧张 -->
      <view wx:if="{{check.canProceed}}" class="check-ok">
        <text class="ck-badge ok">{{check.portStatus === 'TIGHT' ? '⚠ 端口紧张' : '✓ 可安装'}}</text>
        <text class="ck-msg">{{check.message}}</text>
        <text class="ck-port">端口余量：{{check.portRemaining}}</text>
      </view>
      <!-- 拦截 -->
      <view wx:else class="check-bad">
        <text class="ck-badge bad">✕ 暂未覆盖</text>
        <text class="ck-msg">{{check.message}}</text>
        <view class="bad-actions">
          <view class="bad-btn" bindtap="changeCommunity">换个小区</view>
          <view class="bad-btn ghost" bindtap="register">登记需求</view>
        </view>
      </view>
    </block>
  </view>

  <!-- 联系人信息（仅可安装时填写） -->
  <view class="card" wx:if="{{check.canProceed}}">
    <view class="card-title">联系人信息</view>
    <view class="field">
      <text class="f-label">联系人</text>
      <input class="f-input" placeholder="请输入姓名" value="{{form.contact}}" data-field="contact" bindinput="onFormInput" />
    </view>
    <view class="field">
      <text class="f-label">手机号</text>
      <input class="f-input" type="number" placeholder="请输入手机号" value="{{form.phone}}" data-field="phone" bindinput="onFormInput" />
    </view>
    <view class="field">
      <text class="f-label">详细地址</text>
      <input class="f-input" placeholder="楼栋/单元/门牌" value="{{form.addressDetail}}" data-field="addressDetail" bindinput="onFormInput" />
    </view>
    <picker mode="selector" range="{{timeSlots}}" value="{{timeIndex}}" bindchange="onTimeChange">
      <view class="field">
        <text class="f-label">预约时段</text>
        <text class="f-input picker">{{timeSlots[timeIndex]}} ›</text>
      </view>
    </picker>
  </view>
</view>

<!-- 底部下一步 -->
<view class="footer" wx:if="{{searched}}">
  <view class="foot-tip {{check.canProceed ? 'ok' : 'bad'}}">
    {{check.canProceed ? '可正常下单' : '该小区暂不受理'}}
  </view>
  <view class="btn-primary foot-btn {{check.canProceed ? '' : 'disabled'}}" bindtap="submit">下一步</view>
</view>
