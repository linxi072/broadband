<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.1</version>
        <relativePath/>
    </parent>

    <groupId>com.broadband</groupId>
    <artifactId>broadband-backend</artifactId>
    <version>1.0.0</version>
    <name>broadband-backend</name>
    <description>宽带业务系统后端 · 小区覆盖 / 智能派单 / 装维 SLA 赔付 / 套餐与流量（Spring Boot 3.2.1 单体）</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- MyBatis-Plus：Spring Boot 3 必须用 spring-boot3-starter（否则会引入 mybatis-spring 2.x，
             在 Spring 6.1 下启动报 Invalid value type for attribute 'factoryBeanObjectType'） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>3.5.5</version>
        </dependency>
        <!-- 数据库驱动：MySQL（版本由 spring-boot-starter-parent 统一管理） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 安全：RBAC + JWT 鉴权（Spring Security 6）。
             JWT 自身用 JDK 的 HMAC-SHA256 实现（见 system/security/JwtUtil，纯 Java 无三方依赖），
             因此这里不引入 jjwt，保持依赖面最小。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
