.page { min-height: 100vh; background: #f5f7fb; }
.topbar { background: #2563eb; color: #fff; font-size: 32rpx; font-weight: 600; text-align: center; padding: 26rpx 0; }
.body { padding: 24rpx; }
.tone { background: #eff6ff; border: 1rpx solid #bfdbfe; }
.tone .t { font-size: 30rpx; font-weight: 700; }
.mini { font-size: 24rpx; color: #6b7280; margin-top: 6rpx; }
.row-between { display: flex; justify-content: space-between; font-size: 26rpx; margin: 12rpx 0; }
.bold { font-weight: 700; color: #111827; }
.bar { height: 16rpx; background: #e5e7eb; border-radius: 999rpx; overflow: hidden; margin: 8rpx 0; }
.bar-in { height: 100%; background: #2563eb; }
.mini.warn { color: #dc2626; font-weight: 600; }
.trend { display: flex; align-items: flex-end; gap: 10rpx; height: 160rpx; margin-top: 12rpx; }
.bar-col { flex: 1; background: #2563eb; border-radius: 8rpx 8rpx 0 0; }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.chip { border: 1rpx solid #2563eb; color: #2563eb; border-radius: 999rpx; padding: 14rpx 26rpx; font-size: 26rpx; background: #fff; }
.line { font-size: 26rpx; line-height: 1.9; }
