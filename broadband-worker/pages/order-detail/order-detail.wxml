<!-- pages/order-detail/order-detail.wxml -->
<view class="container safe-bottom">
  <block wx:if="{{!order}}">
    <view class="loading"><view class="spinner"></view><view class="muted" style="margin-top:20rpx">加载中…</view></view>
  </block>

  <block wx:else>
    <!-- 顶部状态卡 -->
    <view class="head">
      <view class="head-id">#{{order.id}}</view>
      <view class="tag {{order.statusClass || 'tag-default'}} head-tag">{{order.statusText}}</view>
    </view>

    <view class="card">
      <view class="card-title">安装信息</view>
      <view class="row"><text class="muted">客户</text><text>{{order.cust}}</text></view>
      <view class="row"><text class="muted">联系电话</text><text>{{order.phone}}</text></view>
      <view class="row"><text class="muted">地址</text><text class="wo-addr">{{order.addr}}</text></view>
      <view class="row"><text class="muted">套餐</text><text>{{order.pkg}}</text></view>
      <view class="row"><text class="muted">上门时段</text><text>{{order.slot}}</text></view>
    </view>

    <view class="card">
      <view class="card-title">服务项</view>
      <view class="tags"><text class="pill" wx:for="{{order.items}}" wx:key="*this">{{item}}</text></view>
    </view>

    <view class="grid2">
      <view class="btn-ghost" bindtap="navigate">🧭 导航</view>
      <view class="btn-ghost" bindtap="call">📞 联系客户</view>
    </view>
    <view class="btn-primary" bindtap="start">开始完工回传</view>
  </block>
</view>
