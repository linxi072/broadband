/* pages/service/service.wxss */
.hero {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  border-radius: 24rpx;
  padding: 56rpx 40rpx;
  color: #fff;
  margin-bottom: 24rpx;
}
.hero-title { font-size: 44rpx; font-weight: 700; }
.hero-sub { margin-top: 10rpx; font-size: 26rpx; opacity: 0.9; }

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.cell {
  width: 48.5%;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}
.cell-icon { font-size: 56rpx; }
.cell-name { font-size: 30rpx; font-weight: 600; margin-top: 12rpx; }
.cell-desc { font-size: 22rpx; color: #6b7280; margin-top: 6rpx; }
