/* pages/index/index.wxss —— 师傅端首页 */
.hero {
  background: linear-gradient(160deg, #ffedd5, #fff7ed 70%);
  border-radius: var(--radius-lg);
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}
.hero-top { display: flex; align-items: center; justify-content: space-between; }
.hero-hi { font-size: 36rpx; font-weight: 700; color: #9a3412; }
.hero-sub2 { font-size: 26rpx; color: var(--text-sub); margin-top: 8rpx; }
.hero-avatar {
  width: 84rpx; height: 84rpx; border-radius: 50%;
  background: var(--c); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; box-shadow: var(--shadow);
}
.hero-avatar:active { transform: scale(.95); }
.stats { margin-bottom: 24rpx; }

.wo { padding: 24rpx; margin-bottom: 20rpx; border-radius: var(--radius); background: var(--card); box-shadow: var(--shadow); }
.wo:active { transform: scale(.99); }
.wo-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.wo-id { font-size: 30rpx; font-weight: 600; }
.wo-row { display: flex; align-items: center; padding: 8rpx 0; font-size: 27rpx; }
.wo-row .muted { width: 96rpx; flex: none; }
.wo-addr { flex: 1; text-align: right; color: var(--text); }
.wo-actions { display: flex; gap: 16rpx; margin-top: 18rpx; }
.wo-actions .btn-ghost, .wo-actions .btn-primary { flex: 1; margin-top: 0; }
