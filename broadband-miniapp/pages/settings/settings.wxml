<!-- pages/settings/settings.wxml -->
<view class="container safe-bottom">
  <view class="nav-bar">设置</view>
  <view class="card">
    <view class="cell" wx:for="{{items}}" wx:key="key" data-key="{{item.key}}" data-name="{{item.name}}" bindtap="tap">
      <text class="ic">{{item.icon}}</text>
      <view class="label">
        <view>{{item.name}}</view>
        <view class="cell-sub" wx:if="{{item.desc}}">{{item.desc}}</view>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
  <view class="note-warn" style="margin-top:20rpx">⚠️ 当前为演示环境，部分设置项暂不可用</view>
</view>
