<view class="container">
  <view class="nav-bar">我的订单</view>
  <view class="grid3" style="margin-bottom:16rpx">
    <view class="tile" wx:for="{{tabs}}" wx:key="*this" data-i="{{index}}" bindtap="switchTab" style="{{index===active ? 'outline:3rpx solid var(--c)' : ''}}"><view class="lb">{{item}}</view></view>
  </view>
  <view class="card" wx:for="{{orders}}" wx:key="id">
    <view class="card-title">{{item.name}}</view>
    <view class="row"><text class="muted">订单号</text><text>{{item.id}}</text></view>
    <view class="row"><text class="muted">安装地址</text><text>{{item.addr}}</text></view>
    <view class="row"><text class="muted">状态</text><text class="pill">{{item.statusText}}</text></view>
    <view class="row"><text class="muted">金额</text><text style="color:var(--c);font-weight:700">¥{{item.amount}}</text></view>
    <view class="btn-ghost" data-id="{{item.id}}" bindtap="goDetail">查看详情</view>
  </view>
</view>
