<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.1</version>
        <relativePath/>
    </parent>

    <groupId>com.broadband</groupId>
    <artifactId>broadband-backend</artifactId>
    <version>1.0.0</version>
    <name>broadband-backend</name>
    <description>宽带业务系统后端 · 小区覆盖 / 智能派单 / 装维 SLA 赔付 / 套餐与流量（Spring Boot 3.2.1 单体）</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- MyBatis-Plus：Spring Boot 3 必须用 spring-boot3-starter（否则会引入 mybatis-spring 2.x，
             在 Spring 6.1 下启动报 Invalid value type for attribute 'factoryBeanObjectType'） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>3.5.5</version>
        </dependency>
        <!-- 数据库驱动：MySQL（版本由 spring-boot-starter-parent 统一管理） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 连接池：Alibaba Druid（替代默认 HikariCP）。
             选 druid-spring-boot-3-starter（Spring Boot 3.x 专用 starter）。
             版本固定 1.2.20：本机构建镜像到 aliyun-maven，本地仓库中仅 1.2.20 的
             jar/pom 记录来自 aliyun-maven，1.2.23 记录来自 central，
             离线构建（-o）会因仓库 ID 不匹配而拒绝解析。升级版本需同步确认缓存来源。
             提供连接池监控、慢 SQL 日志、防泄漏回收、StatFilter 等运维能力；
             配置见 application.yml 的 spring.datasource.druid.*。 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
            <version>1.2.20</version>
        </dependency>
        <!-- 安全：RBAC + JWT 鉴权（Spring Security 6）。
             JWT 自身用 JDK 的 HMAC-SHA256 实现（见 system/security/JwtUtil，纯 Java 无三方依赖），
             因此这里不引入 jjwt，保持依赖面最小。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- 缓存：Spring Data Redis（引入 Redis 做读密集数据缓存，降低聚合查询对 MySQL 的压力）。
             连接 127.0.0.1:6379（沙箱已起 redis-server）；通过 app.cache.enabled 开关与
             RedisCacheService 的 fail-safe 包裹，Redis 不可用时自动退化为直查 DB，不会击穿。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 监控（G6 监控深化）：Spring Boot Actuator + Micrometer Prometheus 注册表。
             /actuator/prometheus 供 Prometheus 抓取；HTTP/JVM/GC/线程/连接池指标由 Micrometer 自动采集。
             版本由 spring-boot-starter-parent 3.2.1 统一管理，无需显式指定。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
