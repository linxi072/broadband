<view class="container">
  <view class="card" style="background:var(--c);color:#fff">
    <view style="font-size:36rpx;font-weight:700">{{customer.name}}</view>
    <view style="opacity:.9;margin-top:8rpx">{{customer.phone}} · {{customer.level}}</view>
  </view>
  <view class="grid3">
    <view class="tile" wx:for="{{menus}}" wx:key="key" data-key="{{item.key}}" bindtap="goMenu">
      <view class="ic">{{item.icon}}</view><view class="lb">{{item.name}}</view>
    </view>
  </view>
  <view class="btn-ghost" style="margin-top:24rpx" bindtap="logout">退出登录</view>
</view>
