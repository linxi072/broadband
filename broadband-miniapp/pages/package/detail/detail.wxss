/* pages/package/detail/detail.wxss */
.swiper { width: 100%; height: 360rpx; border-radius: 20rpx; overflow: hidden; }
.slide-img { width: 100%; height: 100%; }
.slide {
  width: 100%; height: 100%;
  display: flex; align-items: flex-end; justify-content: flex-start;
  padding: 28rpx;
}
.slide-label { color: #fff; font-size: 30rpx; font-weight: 600; }
.swiper-idx {
  text-align: right; color: #6b7280; font-size: 22rpx; margin: 10rpx 6rpx 0;
}

.pkg-name { font-size: 36rpx; font-weight: 700; }
.price-row { display: flex; align-items: baseline; margin-top: 12rpx; }
.price { color: #ef4444; font-size: 48rpx; font-weight: 800; }
.price-unit { color: #ef4444; font-size: 24rpx; margin-left: 4rpx; }
.price-old { color: #9ca3af; font-size: 24rpx; text-decoration: line-through; margin-left: 16rpx; }

.converge {
  display: flex; align-items: center;
  padding: 16rpx 0; border-bottom: 1rpx solid #f1f5f9;
}
.converge:last-child { border-bottom: none; }
.c-label {
  width: 120rpx; font-weight: 600; color: #2563eb;
  background: #eff6ff; border-radius: 8rpx; text-align: center; padding: 6rpx 0;
}
.c-desc { margin-left: 20rpx; color: #374151; }

.tag {
  font-size: 20rpx; color: #fff; background: #2563eb;
  border-radius: 6rpx; padding: 2rpx 10rpx; margin-left: 12rpx;
}
.tag.opt { background: #9ca3af; }

.opts { display: flex; flex-wrap: wrap; margin-top: 8rpx; }
.opt {
  border: 2rpx solid #e5e7eb; border-radius: 12rpx;
  padding: 16rpx 24rpx; margin: 12rpx 16rpx 0 0; font-size: 26rpx; color: #374151;
  display: flex; align-items: center;
}
.opt.on { border-color: #2563eb; color: #2563eb; background: #eff6ff; font-weight: 600; }
.fee { font-size: 20rpx; color: #ef4444; margin-left: 8rpx; }

.link { color: #2563eb; text-align: center; }

/* 底部固定栏 */
.footer {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center; justify-content: space-between;
  background: #fff; padding: 16rpx 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(15, 23, 42, 0.06);
}
.foot-price { color: #ef4444; font-size: 40rpx; font-weight: 800; }
.foot-btn { width: 60%; margin: 0; }
