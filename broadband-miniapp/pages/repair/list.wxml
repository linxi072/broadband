<!-- pages/repair/list.wxml -->
<view class="page">
  <view class="header">
    <text class="title">我的报修</text>
    <text class="add" bindtap="goCreate">+ 新建报修</text>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中...</view>

  <view wx:elif="{{list.length === 0}}" class="empty">
    <text>暂无报修记录</text>
    <text class="link" bindtap="goCreate">去报修 ></text>
  </view>

  <view wx:else>
    <view class="item" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
      <view class="item-top">
        <text class="cat">{{item.faultCategoryText || item.faultCategory}}</text>
        <text class="status status-{{item.status}}">{{item.statusText}}</text>
      </view>
      <view class="desc">{{item.faultDesc}}</view>
      <view class="meta">
        <text>{{item.community}}</text>
        <text>{{item.timeSlotText}}</text>
      </view>
      <view class="progress">
        <view class="bar"><view class="fill" style="width: {{(item.progress >= 0 ? item.progress : 0) * 33.3}}%"></view></view>
        <text class="pct">{{item.progress >= 0 ? (item.progress * 33) + '%' : '已撤销'}}</text>
      </view>
    </view>
  </view>
</view>
