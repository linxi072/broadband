/* pages/support/support.wxss */
.faq { background: var(--card); border-radius: var(--radius); margin-bottom: 14rpx; box-shadow: var(--shadow); overflow: hidden; }
.faq-q { display: flex; justify-content: space-between; align-items: center; padding: 26rpx 24rpx; font-size: 28rpx; font-weight: 600; color: var(--ink-900); }
.faq-toggle { font-size: 40rpx; color: var(--c); font-weight: 400; line-height: 1; }
.faq-a { padding: 0 24rpx 26rpx; font-size: 26rpx; color: var(--ink-700); line-height: 1.6; }
.picker { display: flex; justify-content: space-between; align-items: center; }
.picker::after { content: '▾'; color: var(--text-mute); margin-left: 8rpx; }
