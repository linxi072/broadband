/* pages/index/index.wxss */
.hero {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  border-radius: var(--radius-lg);
  padding: 40rpx 36rpx;
  color: #fff;
  box-shadow: 0 10rpx 30rpx rgba(37, 99, 235, .25);
  margin-bottom: 24rpx;
}
.hero-top { display: flex; justify-content: space-between; align-items: center; }
.hero-hi { font-size: 38rpx; font-weight: 700; }
.hero-sub2 { margin-top: 10rpx; font-size: 24rpx; opacity: .9; }
.hero-avatar {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: rgba(255, 255, 255, .2);
  display: flex; align-items: center; justify-content: center; font-size: 40rpx;
}

/* 快捷办理 */
.quick .q { text-align: center; transition: transform .12s; }
.quick .q:active { transform: scale(.94); }
.quick .q-ic { font-size: 48rpx; }
.quick .q-lb { font-size: 24rpx; color: var(--text-sub); margin-top: 10rpx; }

/* 订单进度行 */
.order-row { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 0; }
.order-name { font-size: 30rpx; font-weight: 600; }
.order-l .muted { margin-top: 6rpx; }

/* 热门套餐横滑 */
.pkg-row { display: flex; gap: 16rpx; }
.pkg-scroll { white-space: nowrap; margin: 0 -4rpx; }
.pkg-card {
  display: inline-block; width: 260rpx; margin: 4rpx;
  background: var(--c-50); border-radius: var(--radius);
  padding: 24rpx; vertical-align: top;
}
.pkg-name { font-size: 28rpx; font-weight: 600; }
.pkg-speed { color: var(--c-700); font-size: 24rpx; margin: 6rpx 0; }
.pkg-price { margin-top: 6rpx; }
