/* app.wxss 全局样式 */
page {
  background: #f5f7fb;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  color: #1f2937;
  font-size: 28rpx;
}
.container { padding: 24rpx; }
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}
.card-title::before {
  content: "";
  width: 8rpx;
  height: 30rpx;
  background: #2563eb;
  border-radius: 4rpx;
  margin-right: 14rpx;
}
.btn-primary {
  background: #2563eb;
  color: #fff;
  border-radius: 999rpx;
  text-align: center;
  padding: 26rpx 0;
  font-size: 30rpx;
  font-weight: 600;
}
.muted { color: #6b7280; font-size: 24rpx; }
