<view class="container">
  <view class="nav-bar">续费 / 提速</view>
  <view class="card"><view class="card-title">当前套餐</view><text>{{current}}</text></view>
  <view class="card" wx:for="{{plans}}" wx:key="id">
    <view class="card-title">{{item.name}}</view>
    <view class="row"><text class="muted">说明</text><text>{{item.desc}}</text></view>
    <view class="row"><text class="muted">资费</text><text style="color:var(--c);font-weight:700">{{item.price}}</text></view>
    <view class="btn-primary" data-name="{{item.name}}" bindtap="handle">立即办理</view>
  </view>
</view>
