<view class="container" style="padding-top:120rpx">
  <view style="text-align:center;font-size:44rpx;font-weight:700;color:var(--c)">宽带办理</view>
  <view class="muted" style="text-align:center;margin:12rpx 0 48rpx">登录后办理与查看订单</view>
  <input class="input" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhone" maxlength="11" />
  <view style="display:flex;gap:16rpx;align-items:center">
    <input class="input" style="flex:1" placeholder="验证码" value="{{code}}" bindinput="onCode" />
    <view class="btn-ghost" style="width:220rpx;margin:12rpx 0" bindtap="sendCode">{{sending ? countdown+'s' : '获取验证码'}}</view>
  </view>
  <view class="btn-primary" bindtap="login">登录</view>
  <view class="muted" style="text-align:center;margin-top:24rpx">演示验证码：1234</view>
</view>
