<!-- pages/login/login.wxml -->
<view class="login-wrap">
  <view class="brand">
    <view class="brand-logo">👷</view>
    <view class="brand-title">装维师傅端</view>
    <view class="brand-sub">登录接单 · 回传完工</view>
  </view>

  <view class="login-card">
    <view class="field">
      <text class="field-ic">📱</text>
      <input class="field-input" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhone" maxlength="11" />
    </view>
    <view class="field">
      <text class="field-ic">🔑</text>
      <input class="field-input" placeholder="验证码" value="{{code}}" bindinput="onCode" />
      <view class="code-btn {{sending ? 'disabled' : ''}}" bindtap="sendCode">{{sending ? countdown + 's' : '获取验证码'}}</view>
    </view>
    <view class="login-btn btn-primary" bindtap="login">登录</view>
    <view class="login-tip">演示验证码：1234</view>
  </view>
</view>
