<!-- pages/order/list/list.wxml -->
<view class="container safe-bottom">
  <view class="nav-bar">我的订单</view>
  <view class="seg" style="margin-bottom:20rpx">
    <view class="it {{active===index ? 'on' : ''}}" wx:for="{{tabs}}" wx:key="*this" data-i="{{index}}" bindtap="switchTab">{{item}}</view>
  </view>

  <block wx:if="{{loading}}">
    <view class="card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="sk sk-line" style="width:50%"></view>
      <view class="sk sk-line"></view>
      <view class="sk sk-line" style="width:70%"></view>
    </view>
  </block>

  <view wx:elif="{{list.length === 0}}" class="empty">
    <view class="em-ic">📦</view>
    <view class="em-t">这里还没有订单</view>
    <view class="em-s">办理套餐后即可在此跟踪进度</view>
    <view class="btn-primary" style="margin-top:32rpx" bindtap="goPkg">去办套餐</view>
  </view>

  <block wx:else>
    <view class="card card-tap" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="order-head">
        <view class="order-name">{{item.name}}</view>
        <view class="tag {{item.statusClass}}">{{item.statusText}}</view>
      </view>
      <view class="row"><text class="muted">订单号</text><text>{{item.id}}</text></view>
      <view class="row"><text class="muted">安装地址</text><text class="order-addr">{{item.addr}}</text></view>
      <view class="row"><text class="muted">类型</text><text>{{item.typeText}}</text></view>
      <view class="order-foot">
        <text class="price">¥{{item.amount}}</text>
        <view class="btn-ghost" data-id="{{item.id}}" catchtap="goDetail">查看详情</view>
      </view>
    </view>
  </block>
</view>
