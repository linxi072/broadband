/* ============================================================
   宽带业务管理系统 · 客户端小程序 全局样式 v2.0
   主题色：蓝 #2563eb（与师傅端橙 #ea580c / 后台靛 #4f46e5 区分）
   设计 token 与 web-admin --bd-* 体系对齐
   ============================================================ */
page {
  /* ============ 统一设计系统令牌（与 design-system.html 一致，新增） ============ */
  /* 间距：4rpx 基准栅格 */
  --sp-1: 4rpx;  --sp-2: 8rpx;  --sp-3: 12rpx; --sp-4: 16rpx;
  --sp-5: 20rpx; --sp-6: 24rpx; --sp-8: 32rpx; --sp-10: 40rpx; --sp-12: 48rpx;

  /* 圆角 */
  --r-sm: 12rpx; --r-md: 20rpx; --r-lg: 28rpx; --r-xl: 36rpx; --r-full: 999rpx;

  /* 字体 */
  --font-sans: -apple-system, 'PingFang SC', sans-serif;
  --font-mono: ui-monospace, Menlo, monospace;

  /* 字号阶梯（rpx） */
  --fs-xs: 24rpx; --fs-sm: 26rpx; --fs-base: 28rpx; --fs-md: 30rpx;
  --fs-lg: 34rpx; --fs-xl: 40rpx; --fs-2xl: 48rpx; --fs-3xl: 56rpx;

  /* 中性色 */
  --ink-900: #0f172a; --ink-700: #334155; --ink-500: #64748b;
  --ink-400: #94a3b8; --ink-300: #cbd5e1; --ink-200: #e2e8f0;
  --ink-100: #f1f5f9; --ink-50: #f8fafc; --surface: #ffffff;

  /* 语义状态色 */
  --c-success: #16a34a; --c-success-bg: #dcfce7;
  --c-warning: #d97706; --c-warning-bg: #fef3c7;
  --c-danger:  #dc2626; --c-danger-bg:  #fee2e2;
  --c-info:    #0ea5e9; --c-info-bg:    #e0f2fe;

  /* 阴影 */
  --sh-sm: 0 2rpx 8rpx rgba(15,23,42,.05);
  --sh-md: 0 4rpx 16rpx rgba(15,23,42,.08);

  /* 动效 */
  --t-fast: 120ms ease;
  --t-norm: 240ms ease;

  /* 品牌色（客户端蓝，与既有 --c 体系等值） */
  --brand-50: #eff6ff; --brand-100: #dbeafe; --brand-300: #bfdbfe;
  --brand-500: #2563eb; --brand-600: #1d4ed8; --brand-700: #1e40af;
  --brand-ink: #ffffff; --brand-soft: #eff6ff;

  /* 品牌主色梯度（既有体系，保留供已有页面） */
  --c: #2563eb;
  --c-50: #eff6ff;
  --c-100: #dbeafe;
  --c-200: #bfdbfe;
  --c-600: #1d4ed8;
  --c-700: #1e40af;

  /* 中性色 */
  --bg: #f5f7fb;
  --card: #ffffff;
  --text: #1f2937;
  --text-sub: #6b7280;
  --text-mute: #9ca3af;
  --border: #eef0f4;
  --border-strong: #e2e8f0;

  /* 尺寸 / 阴影 */
  --radius: 20rpx;
  --radius-sm: 12rpx;
  --radius-lg: 28rpx;
  --shadow: 0 4rpx 16rpx rgba(15, 23, 42, .05);
  --shadow-sm: 0 2rpx 8rpx rgba(15, 23, 42, .04);

  /* 业务语义色 */
  --success: #16a34a;
  --warning: #d97706;
  --danger: #dc2626;
  --info: #0ea5e9;

  background: var(--bg);
  font-family: -apple-system, "PingFang SC", sans-serif;
  color: var(--text);
  font-size: 28rpx;
}

/* ---------- 布局 ---------- */
.container { padding: 24rpx; }
.container-lg { padding: 28rpx 28rpx 40rpx; }
.safe-bottom { padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }

/* ---------- 文字层级 ---------- */
.h1 { font-size: 40rpx; font-weight: 700; }
.h2 { font-size: 32rpx; font-weight: 600; }
.sub { color: var(--text-sub); font-size: 26rpx; }
.muted { color: var(--text-mute); font-size: 24rpx; }
.eyebrow { font-size: 24rpx; color: var(--text-mute); font-weight: 600; letter-spacing: 1rpx; margin: 8rpx 4rpx; }
.price { color: var(--c); font-weight: 700; }
.price .u { font-size: 22rpx; font-weight: 500; }

/* ---------- 导航条 ---------- */
.nav-bar { font-size: 34rpx; font-weight: 600; padding: 24rpx 8rpx; }

/* ---------- 卡片 ---------- */
.card { background: var(--card); border-radius: var(--radius); padding: 28rpx; margin-bottom: 24rpx; box-shadow: var(--shadow); }
.card-tap { transition: transform .12s ease; }
.card-tap:active { transform: scale(.985); }
.card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.card-head .more { color: var(--c); font-size: 24rpx; }
.card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; display: flex; align-items: center; }
.card-title::before { content: ""; width: 8rpx; height: 30rpx; background: var(--c); border-radius: 4rpx; margin-right: 14rpx; }

/* ---------- 按钮 ---------- */
.btn-primary { background: var(--c); color: #fff; border-radius: 999rpx; text-align: center; padding: 24rpx 0; font-size: 30rpx; font-weight: 600; margin-top: 16rpx; transition: transform .12s ease, opacity .12s ease; }
.btn-primary:active { transform: scale(.98); opacity: .9; }
.btn-ghost { background: #fff; color: var(--c); border: 2rpx solid var(--c); border-radius: 999rpx; text-align: center; padding: 20rpx 0; font-size: 28rpx; transition: transform .12s ease; }
.btn-ghost:active { transform: scale(.98); }
.btn-block { width: 100%; }

/* ---------- 列表 / 单元格 ---------- */
.row { display: flex; justify-content: space-between; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid var(--border); }
.row:last-child { border-bottom: none; }
.cell { display: flex; align-items: center; padding: 26rpx 4rpx; border-bottom: 1rpx solid var(--border); }
.cell:last-child { border-bottom: none; }
.cell .ic { font-size: 38rpx; margin-right: 18rpx; }
.cell .label { flex: 1; font-size: 28rpx; }
.cell .val { color: var(--text-sub); font-size: 26rpx; margin-right: 8rpx; }
.cell .arrow { color: var(--text-mute); font-size: 30rpx; }

/* ---------- 标签 / 状态 ---------- */
.pill { display: inline-block; background: var(--c-50); color: var(--c-700); font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 999rpx; margin: 4rpx 8rpx 4rpx 0; }
.tag { display: inline-block; font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 999rpx; line-height: 1.4; }
.tag-default { background: var(--bg); color: var(--text-sub); }
.tag-primary { background: var(--c-50); color: var(--c-700); }
.tag-success { background: #dcfce7; color: #15803d; }
.tag-warning { background: #fef3c7; color: #b45309; }
.tag-danger { background: #fee2e2; color: #b91c1c; }
.tag-info { background: #e0f2fe; color: #0369a1; }

/* ---------- 网格 / 磁贴 ---------- */
.grid2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20rpx; }
.grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20rpx; }
.grid4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; }
.tile { background: var(--card); border-radius: 16rpx; padding: 28rpx 12rpx; text-align: center; box-shadow: var(--shadow-sm); transition: transform .12s ease; }
.tile:active { transform: scale(.97); }
.tile .ic { font-size: 46rpx; }
.tile .lb { font-size: 24rpx; color: #374151; margin-top: 10rpx; }

/* ---------- 指标卡 ---------- */
.stat { background: var(--c); color: #fff; border-radius: 16rpx; padding: 24rpx; text-align: center; }
.stat .n { font-size: 40rpx; font-weight: 700; }
.stat .l { font-size: 22rpx; opacity: .92; }

/* ---------- 进度条 ---------- */
.bar { height: 18rpx; background: #e5e7eb; border-radius: 999rpx; overflow: hidden; margin-top: 8rpx; }
.bar > view { height: 100%; background: var(--c); }
.bar.full > view { background: var(--danger); }

/* ---------- 表单 ---------- */
.input { background: #f8fafc; border: 1rpx solid var(--border-strong); border-radius: var(--radius-sm); padding: 20rpx; margin: 12rpx 0; font-size: 28rpx; }
textarea.input { width: auto; height: 160rpx; }

/* ---------- 步骤 ---------- */
.step { display: flex; align-items: center; margin: 10rpx 0; }
.step .dot { width: 36rpx; height: 36rpx; border-radius: 50%; background: #e5e7eb; color: #94a3b8; font-size: 22rpx; text-align: center; line-height: 36rpx; margin-right: 16rpx; }
.step.done .dot { background: var(--c); color: #fff; }

/* ---------- 搜索 ---------- */
.search { display: flex; align-items: center; background: var(--card); border-radius: 999rpx; padding: 16rpx 24rpx; box-shadow: var(--shadow-sm); }
.search .ph { color: var(--text-mute); font-size:26rpx; flex: 1; }

/* ---------- 分段控件 ---------- */
.seg { display: flex; background: var(--bg); border-radius: 999rpx; padding: 6rpx; gap: 6rpx; }
.seg .it { flex: 1; text-align: center; padding: 14rpx 0; font-size: 26rpx; color: var(--text-sub); border-radius: 999rpx; transition: all .15s; }
.seg .it.on { background: var(--card); color: var(--c); font-weight: 600; box-shadow: var(--shadow-sm); }

/* ---------- 头像 / 徽标 ---------- */
.avatar { width: 88rpx; height: 88rpx; border-radius: 50%; background: var(--c-50); color: var(--c-700); display: flex; align-items: center; justify-content: center; font-size: 34rpx; font-weight: 600; }
.badge { position: absolute; top: -6rpx; right: -6rpx; min-width: 32rpx; height: 32rpx; padding: 0 8rpx; background: var(--danger); color: #fff; font-size: 20rpx; border-radius: 999rpx; display: flex; align-items: center; justify-content: center; }

/* ---------- 分割线 ---------- */
.divider { height: 1rpx; background: var(--border); margin: 20rpx 0; }

/* ---------- 提示 ---------- */
.note { background: var(--c-50); color: var(--c-700); font-size: 24rpx; padding: 18rpx 22rpx; border-radius: var(--radius-sm); }
.note-warn { background: #fef3c7; color: #b45309; }

/* ---------- 空态 ---------- */
.empty { padding: 100rpx 30rpx; text-align: center; color: var(--text-mute); }
.empty .em-ic { font-size: 96rpx; opacity: .45; }
.empty .em-t { font-size: 28rpx; margin-top: 20rpx; color: var(--text-sub); }
.empty .em-s { font-size: 24rpx; margin-top: 8rpx; }
.empty .btn-primary, .empty .btn-ghost { margin-top: 36rpx; }

/* ---------- 骨架屏 ---------- */
.sk { background: linear-gradient(90deg, #eef1f5 25%, #f6f8fa 37%, #eef1f5 63%); background-size: 400% 100%; animation: sk 1.4s ease infinite; border-radius: 8rpx; }
@keyframes sk { 0% { background-position: 100% 0 } 100% { background-position: 0 0 } }
.sk-line { height: 24rpx; margin: 16rpx 0; }
.sk-block { height: 200rpx; border-radius: var(--radius); }
.sk-circle { width: 80rpx; height: 80rpx; border-radius: 50%; }

/* ---------- 加载 ---------- */
.loading { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 80rpx 0; color: var(--text-mute); }
.spinner { width: 56rpx; height: 56rpx; border: 6rpx solid var(--c-100); border-top-color: var(--c); border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg) } }

/* ---------- 悬浮按钮 ---------- */
.fab { position: fixed; right: 36rpx; bottom: calc(40rpx + env(safe-area-inset-bottom)); width: 104rpx; height: 104rpx; border-radius: 50%; background: var(--c); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 48rpx; box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, .18); z-index: 50; }
.fab:active { transform: scale(.94); }

/* ---------- 底部操作条 ---------- */
.action-bar { position: fixed; left: 0; right: 0; bottom: 0; background: var(--card); padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); box-shadow: 0 -4rpx 16rpx rgba(15, 23, 42, .06); display: flex; gap: 16rpx; }
.action-bar .btn-primary, .action-bar .btn-ghost { flex: 1; margin-top: 0; }
