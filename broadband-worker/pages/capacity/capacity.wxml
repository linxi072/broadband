<!-- pages/capacity/capacity.wxml -->
<view class="container safe-bottom">
  <view class="nav-bar">容量看板</view>

  <view wx:if="{{empty}}" class="empty">
    <view class="em-ic">🗓️</view>
    <view class="em-t">{{date}} 暂无容量配置</view>
  </view>

  <view wx:else class="card">
    <view class="card-title">{{date}} 师傅时段容量</view>
    <view class="slot" wx:for="{{slots}}" wx:key="time">
      <view class="slot-head">
        <text class="slot-time">{{item.time}}</text>
        <text class="muted">{{item.used}}/{{item.max}} 单{{item.used>=item.max ? ' · 已满' : ''}}</text>
      </view>
      <view class="bar {{item.used>=item.max ? 'full' : ''}}"><view style="width:{{item.pct}}%"></view></view>
    </view>
  </view>

  <view class="note">
    📌 相邻小区每时段 3-4 单、非相邻 1-2 单；满容工单将自动顺延至下一时段。
  </view>
</view>
