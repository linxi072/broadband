<!-- pages/review/review.wxml -->
<view class="container safe-bottom">
  <view class="nav-bar">评价与投诉</view>
  <view class="card">
    <view class="card-title">本次服务评分</view>
    <view class="stars">
      <text wx:for="{{5}}" wx:key="*this" data-i="{{index + 1}}" bindtap="setStar" class="star {{index < stars ? 'on' : ''}}">★</text>
    </view>
    <view class="star-hint">{{starHint}}</view>
    <view class="tags">
      <text wx:for="{{tags}}" wx:key="*this" class="pill {{selected.indexOf(item) >= 0 ? 'pill-on' : ''}}" data-t="{{item}}" bindtap="toggleTag">{{item}}</text>
    </view>
  </view>
  <view class="card">
    <view class="card-title">投诉与建议</view>
    <textarea class="input" placeholder="如有问题，请描述（可上传照片）" bindinput="onComplaint" value="{{complaint}}"></textarea>
    <view class="btn-primary" bindtap="submit">提交</view>
  </view>
  <view class="card">
    <view class="card-title">我的投诉进度</view>
    <view class="row"><text class="muted">工单状态</text><text class="tag tag-warning">处理中</text></view>
    <view class="row"><text class="muted">预计回复</text><text>24 小时内</text></view>
  </view>
</view>
