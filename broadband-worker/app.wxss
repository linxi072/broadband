page { --c: #ea580c; background: #fff7ed; font-family: -apple-system,"PingFang SC",sans-serif; color: #1f2937; font-size: 28rpx; }

.container { padding: 24rpx; }
.nav-bar { font-size: 34rpx; font-weight: 600; padding: 24rpx 8rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 16rpx rgba(15,23,42,.05); }
.card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; display: flex; align-items: center; }
.card-title::before { content: ""; width: 8rpx; height: 30rpx; background: var(--c); border-radius: 4rpx; margin-right: 14rpx; }
.btn-primary { background: var(--c); color: #fff; border-radius: 999rpx; text-align: center; padding: 24rpx 0; font-size: 30rpx; font-weight: 600; margin-top: 16rpx; }
.btn-ghost { background: #fff; color: var(--c); border: 2rpx solid var(--c); border-radius: 999rpx; text-align: center; padding: 20rpx 0; font-size: 28rpx; }
.muted { color: #6b7280; font-size: 24rpx; }
.row { display: flex; justify-content: space-between; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #f1f5f9; }
.row:last-child { border-bottom: none; }
.pill { display: inline-block; background: #eef2ff; color: var(--c); font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 999rpx; margin: 4rpx 8rpx 4rpx 0; }
.grid2 { display: grid; grid-template-columns: repeat(2,1fr); gap: 20rpx; }
.grid3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 20rpx; }
.tile { background: #fff; border-radius: 16rpx; padding: 28rpx 12rpx; text-align: center; box-shadow: 0 2rpx 10rpx rgba(15,23,42,.04); }
.tile .ic { font-size: 46rpx; }
.tile .lb { font-size: 24rpx; color: #374151; margin-top: 10rpx; }
.stat { background: var(--c); color: #fff; border-radius: 16rpx; padding: 24rpx; text-align: center; }
.stat .n { font-size: 40rpx; font-weight: 700; }
.stat .l { font-size: 22rpx; opacity: .92; }
.bar { height: 18rpx; background: #e5e7eb; border-radius: 999rpx; overflow: hidden; margin-top: 8rpx; }
.bar > view { height: 100%; background: var(--c); }
.bar.full > view { background: #ef4444; }
.input { background: #f8fafc; border: 1rpx solid #e2e8f0; border-radius: 12rpx; padding: 20rpx; margin: 12rpx 0; font-size: 28rpx; }
textarea.input { width: auto; height: 160rpx; }
.step { display: flex; align-items: center; margin: 10rpx 0; }
.step .dot { width: 36rpx; height: 36rpx; border-radius: 50%; background: #e5e7eb; color: #94a3b8; font-size: 22rpx; text-align: center; line-height: 36rpx; margin-right: 16rpx; }
.step.done .dot { background: var(--c); color: #fff; }

.pill { background: #ffedd5; }
