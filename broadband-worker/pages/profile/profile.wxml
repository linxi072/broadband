<!-- pages/profile/profile.wxml -->
<view class="container safe-bottom">
  <view class="hero">
    <view class="hero-name">{{worker.name}}</view>
    <view class="hero-sub">工号 {{worker.no}} · {{worker.phone}} · ⭐{{worker.star}}</view>
  </view>

  <view class="grid3 stats">
    <view class="stat" wx:for="{{stats}}" wx:key="l">
      <view class="n">{{item.n}}</view><view class="l">{{item.l}}</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">客户评价标签</view>
    <view class="tags"><text class="pill" wx:for="{{tags}}" wx:key="*this">{{item}}</text></view>
  </view>

  <view class="btn-ghost" style="margin-top:24rpx" bindtap="logout">退出登录</view>
</view>
