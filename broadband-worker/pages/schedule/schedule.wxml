<!-- pages/schedule/schedule.wxml -->
<view class="container safe-bottom">
  <view class="nav-bar">我的排班</view>

  <view wx:if="{{empty}}" class="empty">
    <view class="em-ic">🌙</view>
    <view class="em-t">未来 7 天暂无排班</view>
  </view>

  <view wx:else>
    <view class="shift" wx:for="{{shifts}}" wx:key="day">
      <view class="shift-day">{{item.day}}</view>
      <view class="shift-val {{item.rest ? 'rest' : ''}}">
        <text wx:if="{{item.rest}}">休息</text>
        <text wx:else>{{item.am}} / {{item.pm}}</text>
      </view>
    </view>
  </view>
</view>
